# Asset root for the file-backed API routes.
# Default behavior:
# DATA_DIR=public
#
# Sample dataset:
DATA_DIR=public/sample-data
# DATA_DIR=public

# Slider/UI date range.
# Format: YYYY-MM-DDTHH:mm
# Interpreted as UTC.
NEXT_PUBLIC_DATA_START_DATE=2021-11-08T11:00
NEXT_PUBLIC_DATA_END_DATE=2021-11-12T15:00

